[Unit]
Description=pico2hsm periodic sync verification (every 5 minutes)
Documentation=https://github.com/pico2hsm/pico2hsm

[Timer]
# Run verify-sync every 5 minutes.
OnCalendar=*:0/5
# Do not catch up on missed runs (e.g. if the machine was asleep).
Persistent=false

[Install]
WantedBy=timers.target
